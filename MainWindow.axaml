<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:WeatherApp.ViewModels"
		xmlns:models="using:WeatherApp.Models"
		xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
		x:Class="WeatherApp.MainWindow"
		x:DataType="vm:MainViewModel"
		Title="Wettervorhersage"
		Width="900" Height="680"
		MinWidth="700" MinHeight="500"
		Background="#1E1E2E">

	<Window.DataContext>
		<vm:MainViewModel />
	</Window.DataContext>

	<Window.Styles>
		<!-- Karten-Stil für jede 3h-Vorhersage -->
		<Style Selector="Border.card">
			<Setter Property="Background" Value="#2A2A3E"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="12"/>
			<Setter Property="Margin" Value="4"/>
			<Setter Property="MinWidth" Value="90"/>
		</Style>
		<Style Selector="TextBlock.header">
			<Setter Property="FontSize" Value="22"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="TextBlock.label">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="#AAAACC"/>
		</Style>
		<Style Selector="TextBlock.value">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="TextBlock.emoji">
			<Setter Property="FontSize" Value="28"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

		<!-- Zeile 0: Eingabe -->
		<Border Grid.Row="0" Background="#2A2A3E" CornerRadius="10" Padding="14" Margin="0,0,0,10">
			<Grid ColumnDefinitions="*,16,Auto">
				<StackPanel Grid.Column="0" Spacing="4">
					<TextBlock Text="Stadt" Classes="label"/>
					<TextBox Text="{Binding City}"
							 Watermark="z. B. Bestwig"
							 CornerRadius="6"/>
				</StackPanel>
				<Button Grid.Column="2"
						Command="{Binding LoadWeatherCommand}"
						IsEnabled="{Binding !IsLoading}"
						VerticalAlignment="Bottom"
						Padding="20,8"
						CornerRadius="6"
						Background="#4285F4"
						Foreground="White"
						FontWeight="SemiBold">
					<Panel>
						<TextBlock Text="🔍 Laden" IsVisible="{Binding !IsLoading}"/>
						<TextBlock Text="⏳ Laden…" IsVisible="{Binding IsLoading}"/>
					</Panel>
				</Button>
			</Grid>
		</Border>

		<!-- Zeile 1: Stadttitel -->
		<StackPanel Grid.Row="1" Margin="0,0,0,10">
			<TextBlock Text="{Binding CityTitle}"
					   Classes="header"
					   IsVisible="{Binding CityTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
		</StackPanel>

		<!-- Zeile 2: Karten + Diagramm -->
		<Grid Grid.Row="2" RowDefinitions="Auto,*">

			<!-- Vorhersage-Karten -->
			<ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto"
						  VerticalScrollBarVisibility="Disabled"
						  Margin="0,0,0,10">
				<ItemsControl ItemsSource="{Binding TodayCards}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="models:ForecastCardModel">
							<Border Classes="card">
								<StackPanel Spacing="6" HorizontalAlignment="Center">
									<TextBlock Text="{Binding Time}"
											   Classes="label"
											   HorizontalAlignment="Center"/>
									<TextBlock Text="{Binding IconEmoji}"
											   Classes="emoji"/>
									<TextBlock Text="{Binding TempDisplay}"
											   Classes="value"
											   HorizontalAlignment="Center"/>
									<TextBlock Text="{Binding Description}"
											   Classes="label"
											   HorizontalAlignment="Center"
											   TextWrapping="Wrap"
											   MaxWidth="90"
											   TextAlignment="Center"/>
									<TextBlock Text="{Binding HumidityDisplay}"
											   Classes="label"
											   HorizontalAlignment="Center"/>
									<TextBlock Text="{Binding WindDisplay}"
											   Classes="label"
											   HorizontalAlignment="Center"/>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>

			<!-- Temperatur-Diagramm -->
			<Border Grid.Row="1" Background="#2A2A3E" CornerRadius="10" Padding="8">
				<lvc:CartesianChart Series="{Binding TemperatureSeries}"
									XAxes="{Binding XAxes}"
									YAxes="{Binding YAxes}"
									Background="Transparent"/>
			</Border>
		</Grid>

		<!-- Zeile 3: Statusleiste -->
		<Border Grid.Row="3" Background="#2A2A3E" CornerRadius="8"
				Padding="10,6" Margin="0,10,0,0">
			<TextBlock Text="{Binding StatusMessage}"
					   Foreground="#AAAACC"
					   FontSize="12"/>
		</Border>

	</Grid>
</Window>
